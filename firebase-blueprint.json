{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "Nail studio service offering",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Name of the nail service"
        },
        "category": {
          "type": "string",
          "enum": ["Alongamento", "Manutenção", "Banho de Gel & Blindagem", "Nail Art & Spa"],
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 300
        },
        "durationMinutes": {
          "type": "number",
          "description": "Duration in minutes"
        },
        "priceCents": {
          "type": "number",
          "description": "Price in BRL cents"
        },
        "imageKey": {
          "type": "string",
          "maxLength": 60
        },
        "active": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "category", "description", "durationMinutes", "priceCents", "imageKey", "active", "createdAt", "updatedAt"]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "Publicly readable slot occupancy without client PII",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "maxLength": 5
        },
        "durationMinutes": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "blocked", "cancelled"],
          "maxLength": 20
        },
        "appointmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["date", "time", "durationMinutes", "status", "appointmentId", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Full appointment record including client contact details",
      "type": "object",
      "properties": {
        "protocolCode": {
          "type": "string",
          "pattern": "^MC-[A-Z0-9]{6}$",
          "maxLength": 10
        },
        "clientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "clientPhone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 25
        },
        "clientInstagram": {
          "type": "string",
          "maxLength": 50
        },
        "serviceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "serviceName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "serviceCategory": {
          "type": "string",
          "maxLength": 40
        },
        "priceCents": {
          "type": "number"
        },
        "durationMinutes": {
          "type": "number"
        },
        "nailShape": {
          "type": "string",
          "enum": ["Amendoada", "Quadrada", "Bailarina", "Stiletto", "Natural"],
          "maxLength": 20
        },
        "nailFinish": {
          "type": "string",
          "enum": ["Francesa Reversa / Sorriso", "Encapsulada com Flores / Ouro", "Cat-Eye / Cromado Prata", "Baby Boomer & Glitter", "Nude Translúcido Natural"],
          "maxLength": 50
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "time": {
          "type": "string",
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "maxLength": 5
        },
        "slotId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "notes": {
          "type": "string",
          "maxLength": 250
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocolCode",
        "clientName",
        "clientPhone",
        "clientInstagram",
        "serviceId",
        "serviceName",
        "serviceCategory",
        "priceCents",
        "durationMinutes",
        "nailShape",
        "nailFinish",
        "date",
        "time",
        "slotId",
        "notes",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized studio administrator",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["owner", "admin"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Public catalog of nail services managed by studio admin"
    },
    "/bookedSlots/{slotId}": {
      "schema": { "$ref": "#/entities/BookedSlot" },
      "description": "Publicly readable slot occupancy records without PII"
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private client appointment records containing PII"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role directory"
    }
  }
}
